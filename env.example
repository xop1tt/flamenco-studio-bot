BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMINS=123456789
ENV=development
# Часовой пояс студии (IANA): в нём бот показывает время занятий и сроки
# отмены. Сайт должен использовать то же значение (STUDIO_TIMEZONE в его .env).
STUDIO_TIMEZONE=Europe/Moscow
# Максимум занятий за одну ручную корректировку баланса (/credits_adjust),
# в любую сторону. Защита от опечатки администратора, а не правило студии.
CREDIT_ADJUSTMENT_MAX_DELTA=50
# Публичный адрес сайта студии (https). Необязателен: если задан, бот
# ссылается на сайт в «О студии» и «Профиле».
WEBSITE_URL=
# Напоминание о занятии: за сколько часов до начала (0–72, 0 — выключено).
LESSON_REMINDER_HOURS=3
# Имя бота для входа на сайт через бота (t.me/<имя>?start=…). Необязательно:
# без него API один раз запрашивает имя у Telegram.
BOT_USERNAME=
DATABASE_URL=
DATABASE_SSL_CA=
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/
# Отдельный return_url для оплаты, начатой на сайте (не в боте) — иначе
# пользователь после оплаты попадёт в Telegram вместо сайта. Пока пусто,
# checkout на сайте недоступен (503) — заполните перед реальным подключением
# ЮKassa к сайту, например https://your-domain.example/account/payments.
WEB_YOOKASSA_RETURN_URL=
BACKUP_DOCKER_NETWORK=
BACKUP_PGHOST=
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=
BACKUP_PGUSER=
BACKUP_PGPASSWORD=
BACKUP_PGSSLMODE=verify-full
BACKUP_PGSSLROOTCERT=/etc/ssl/cert.pem
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
